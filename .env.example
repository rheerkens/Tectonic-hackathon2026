# Copy to `.env` (git-ignored). `bun run dev` loads it for every process in the stack.

# ---- Authentication ------------------------------------------------------
# dev-bypass : no login; pick a deterministic demo identity in the UI (local only).
# clerk      : real Clerk sessions. Required in production and on Railway.
# Leave empty to auto-select: clerk when CLERK_SECRET_KEY is set, otherwise dev-bypass.
AUTH_MODE=

# Clerk (https://dashboard.clerk.com -> API keys). Leave empty until provided.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# ---- API ------------------------------------------------------------------
# Comma-separated extra CORS origins (native shells are allowed by default).
# With Clerk these (plus https://$RAILWAY_PUBLIC_DOMAIN) are also the allowed token origins (azp);
# add native-shell origins here too if they sign in with Clerk.
CORS_ORIGINS=

# ---- Database -------------------------------------------------------------
# Local development: leave empty, `bun run dev` provisions a per-worktree Postgres.
# Production / Railway: injected by the Railway Postgres service.
DATABASE_URL=

# ---- Web build (native shells / hosted backend) ---------------------------
# Absolute API origin baked into the web bundle, e.g. https://api.example.railway.app
# Leave empty for same-origin (web dev proxy or the API serving the built frontend).
VITE_API_ORIGIN=

# ---- AI: chat (POST /api/chat) and claim extraction (POST /api/check) -------
# Leave ANTHROPIC_API_KEY empty to run the deterministic fallbacks (no model, no network).
# With a key the chat model calls the find_knowledge / assess_trust / get_source tools and /api/check
# extracts claims with the model; any failure falls back.
ANTHROPIC_API_KEY=
# Optional, one model for both. Default claude-haiku-4-5 (fast). Use claude-sonnet-5-5 for more capable answers.
# ANTHROPIC_MODEL is still accepted as an alias.
# LLM_MODEL=claude-haiku-4-5
# Optional overall deadline per chat request in ms (default 25000), after which the fallback answers.
# LLM_TIMEOUT_MS=25000
