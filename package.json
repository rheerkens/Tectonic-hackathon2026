{
  "name": "tectonic-hackathon-2026",
  "private": true,
  "version": "0.1.0",
  "description": "SD Trust: explainable, substantiated answers from organisational knowledge. Bun + Hono + React/Vite + Postgres/Drizzle.",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "preinstall": "bun scripts/require-bun.ts",
    "dev": "bun tools/dev/src/cli.ts up",
    "dev:stop": "bun tools/dev/src/cli.ts stop",
    "dev:status": "bun tools/dev/src/cli.ts status",
    "dev:env": "bun tools/dev/src/cli.ts env",
    "start": "bun apps/api/src/index.ts",
    "build": "bun run --cwd apps/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test tools/dev",
    "check": "bun run typecheck && bun run build",
    "video:snippets": "bun run --cwd tools/video snippets",
    "video:gallery": "bun run --cwd tools/video gallery",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:seed": "bun run --cwd packages/db seed",
    "railway:link": "bash scripts/railway-link.sh",
    "railway:deploy": "bash scripts/railway-deploy.sh",
    "test:e2e": "bun run --cwd tools/e2e test"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "protobufjs": "8.8.0",
    "inline-style-parser": "0.2.9",
    "yaml": "2.9.1"
  },
  "trustedDependencies": [
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-arm",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/linux-ia32",
    "@embedded-postgres/linux-ppc64",
    "@embedded-postgres/linux-x64",
    "@embedded-postgres/windows-x64"
  ]
}
